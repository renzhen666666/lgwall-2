  "apps\\apps": {
    "html": "\r\n\r\n\r\n<main class=\"container mt-5\">\r\n\r\n    <section class=\"text-center mb-5\" data-aos=\"fade-up\">\r\n        <h1 class=\"display-4 fw-bold mb-3\">应用广场</h1>\r\n        <p class=\"lead\">为龙高学子打造的实用工具</p>\r\n    </section>\r\n\r\n\r\n    <section class=\"category-filter\" data-aos=\"fade-up\">\r\n        <div class=\"text-center mb-4\">\r\n            <h3>按类别筛选</h3>\r\n        </div>\r\n        <div class=\"d-flex flex-wrap justify-content-center\">\r\n            <button class=\"category-btn active\" data-category=\"all\">全部</button>\r\n            <button class=\"category-btn\" data-category=\"utilities\">实用工具</button>\r\n            <button class=\"category-btn\" data-category=\"productivity\">生产力</button>\r\n            <button class=\"category-btn\" data-category=\"entertainment\">娱乐休闲</button>\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <section data-aos=\"fade-up\">\r\n        <div class=\"app-grid\" id=\"app-list\">\r\n            <div class=\"text-center\">\r\n                <div class=\"spinner-border\" role=\"status\">\r\n                    <span class=\"visually-hidden\">加载中...</span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <section class=\"mt-5\" data-aos=\"fade-up\">\r\n        <h3 class=\"mb-4\">更多应用？</h3>\r\n        \r\n        <div class=\"card mt-4\">\r\n            <div class=\"card-body\">\r\n\r\n                <h4 class=\"card-title mb-3\">提交你的网站？</h4>\r\n                <small class=\"card-text mb-1\">你制作了有趣的网站或Web应用？快来分享给龙高同学们使用吧！</small>\r\n\r\n                <div class=\"row\">\r\n                    <div class=\"col-md-6 mb-3\">\r\n                        <div class=\"d-flex\">\r\n                            <div class=\"me-3\">\r\n                                <span class=\"badge bg-primary rounded-pill\">1</span>\r\n                            </div>\r\n                            <div>\r\n                                <h5>准备你的作品</h5>\r\n                                <p class=\"mb-0\">确保你的网站可以正常访问，并且内容符合校园规范。</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"col-md-6 mb-3\">\r\n                        <div class=\"d-flex\">\r\n                            <div class=\"me-3\">\r\n                                <span class=\"badge bg-primary rounded-pill\">2</span>\r\n                            </div>\r\n                            <div>\r\n                                <h5>提交申请</h5>\r\n                                <p class=\"mb-0\">发送邮件至 <a href=\"mailto:w@r-z.top\">w@r-z.top</a>，附上作品链接。</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"col-md-6 mb-3\">\r\n                        <div class=\"d-flex\">\r\n                            <div class=\"me-3\">\r\n                                <span class=\"badge bg-primary rounded-pill\">3</span>\r\n                            </div>\r\n                            <div>\r\n                                <h5>展示与分享</h5>\r\n                                <p class=\"mb-0\">审核通过后，你的作品将展示在应用广场供同学们使用。</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n</main>\r\n\r\n\r\n<footer class=\"bg-dark text-light py-5 mt-5\">\r\n    <div class=\"container text-center\">\r\n        <p class=\"mb-4\">&copy; 2025 龙华高级中学校园墙 - 应用广场</p>\r\n        <div>\r\n            <a href=\"/\" class=\"text-light me-3\"><i class=\"bi bi-house-door\"></i> 返回首页</a>\r\n            <a href=\"/wall\" class=\"text-light me-3\"><i class=\"bi bi-chat-square-text\"></i> 校园墙</a>\r\n            <a href=\"/help\" class=\"text-light\"><i class=\"bi bi-question-circle\"></i> 帮助中心</a>\r\n        </div>\r\n    </div>\r\n</footer>\r\n",
    "config": {
