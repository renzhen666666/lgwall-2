  "help\\report\\help_report": {
    "html": "<div class=\"card\">\r\n    <div class=\"card-header\">\r\n        <h1>如何举报？</h1>\r\n    </div>\r\n    <div class=\"card-body\">\r\n        <p>点击消息右侧三个点下的\"举报\"按钮，即可举报该消息。</p>\r\n    </div>\r\n</div>\r\n",
