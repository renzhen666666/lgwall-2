  "help\\help": {
    "html": "<main class=\"container\">\r\n    <h1>您遇到了什么问题？</h1>\r\n\r\n    <div class=\"help-options-container\">\r\n        <div class=\"help-option-card\" onclick=\"jumpTo('/help/report')\">\r\n            <div class=\"option-icon\">🚩</div>\r\n            <h3 class=\"white-text\">我被\"挂\"了</h3>\r\n            <p class=\"white-text\">举报删帖</p>\r\n        </div>\r\n        \r\n        <div class=\"help-option-card\" onclick=\"window.location.href='/help/form?ti=联系我们&h1=联系我们&te=如果您有任何问题或建议，请填写以下表单，我们会尽快回复您。'\">\r\n            <div class=\"option-icon\">💬</div>\r\n            <h3 class=\"white-text\">联系我们</h3>\r\n        </div>\r\n        \r\n        <div class=\"help-option-card\" onclick=\"window.location.href='/help/form?ti=意见反馈&h1=意见反馈'\">\r\n            <div class=\"option-icon\">📝</div>\r\n            <h3 class=\"white-text\">意见反馈</h3>\r\n            <p class=\"white-text\">向我们提出宝贵建议</p>\r\n        </div>\r\n    </div>\r\n</main>",
    "config": {
      "title": "帮助",
