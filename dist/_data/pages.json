  "wall\\wall": {
    "html": "{publish_btn}\r\n<li class=\"nav-item ms-2\">\r\n    <button class=\"white btn btn-primary\" id=\"publishBtn\" data-bs-toggle=\"modal\" data-bs-target=\"#publishModal\">\r\n        <i class=\"bi bi-pencil-square me-1\"></i> 我要发贴\r\n    </button>\r\n</li>\r\n{/publish_btn}\r\n\r\n\r\n<main class=\"container mt-4 g-4\" id=\"main-content\">\r\n    <h1>欢迎来到龙*高校园墙</h1>\r\n    <div class=\"row md-4 g-4\">\r\n        <div class=\"col-12\">\r\n            <form class=\"search-bar\" id=\"search-form\">\r\n                <input class=\"search-input\" type=\"text\" placeholder=\"搜索...\" value=\"\" id=\"search-text\">\r\n                <button class=\"btn-close\" type=\"button\" data-on-click=\"clearSearch()\"> </button>\r\n                <button class=\"search-btn\" type=\"button\" data-on-click=\"refreshMessages()\">搜索</button>\r\n            </form>\r\n        </div>\r\n        <div class=\"col-12 mb-2\">\r\n            <div class=\"filter-sort-container p-3 rounded-3 shadow-sm border g-3\">\r\n                <div class=\"d-flex flex-row flex-nowrap align-items-center\" style=\"gap: 1rem;\">\r\n                    <div class=\"d-flex align-items-center flex-shrink-0\">\r\n                        <label class=\"sort-label fw-bold me-2 mb-0\">筛选:</label>\r\n                        <select class=\"form-select sort-options-select\" id=\"filter\" data-on-change=\"refreshMessages()\">\r\n                            <option value=\"all\">全部</option>\r\n                            <option value=\"files\">有图/视频</option>\r\n                        </select>\r\n                    </div>\r\n                    <div class=\"d-flex align-items-center flex-shrink-0\">\r\n                        <label class=\"sort-label fw-bold me-2 mb-0\">排序方式:</label>\r\n                        <select class=\"form-select sort-options-select\" id=\"sort-by\" data-on-change=\"refreshMessages()\">\r\n                            <option value=\"newest\">最新</option>\r\n                            <option value=\"likes\">👍最多</option>\r\n                            <option value=\"dislikes\">👎最多</option>\r\n                        </select>\r\n                    </div>\r\n                </div>\r\n                <div class=\"ms-auto flex-shrink-0\">\r\n                    <button class=\"btn-refresh\" data-on-click=\"refreshMessages();\"><i class=\"bi bi-arrow-clockwise me-1\"></i>刷新</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"col-12\">\r\n            <div class=\"messages-container hidden-scrollbar\">\r\n                <ul class=\"message-box hidden-scrollbar\" id=\"message-box\">\r\n                </ul>\r\n                <div id=\"loading\" style=\"display: none;\">\r\n                    <div class=\"text-center\">\r\n                        <div class=\"spinner-border\" role=\"status\">\r\n                            <span class=\"visually-hidden\">加载中...</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</main>\r\n\r\n\r\n<div class=\"modal fade\" id=\"publishModal\" tabindex=\"-1\" aria-labelledby=\"publishModalLabel\" aria-hidden=\"true\">\r\n    <div class=\"modal-dialog\">\r\n        <div class=\"modal-content\" style=\"background-color: #fff;\">\r\n            <div class=\"modal-header\">\r\n                <h5 class=\"modal-title\" id=\"publishModalLabel\">发布新消息</h5>\r\n                <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\">X</button>\r\n            </div>\r\n            <div class=\"modal-body\">\r\n                <form id=\"input-form\" class=\"form-container\"\r\n                 onsubmit=\"event.preventDefault();\"\r\n                 data-on-submit=\"handleFormSubmit()\">\r\n                    <textarea \r\n                        name=\"text\" \r\n                        id=\"text-input\"\r\n                        class=\"form-textarea\" \r\n                        placeholder=\"想说什么就说什么...\"\r\n                        rows=\"4\"></textarea>\r\n\r\n                    <input hidden type=\"text\" name=\"tags\" id=\"tags-input-hidden\">    \r\n\r\n                    <div class=\"bgc form-group\">\r\n                        <div class=\"tags-input-container\">\r\n                            <div class=\"tag-pre-wrp\" id=\"tag-pre-wrp\"></div>\r\n                            <input \r\n                                type=\"text\" \r\n                                id=\"tags-input\" \r\n                                class=\"tags-input\" \r\n                                placeholder=\"添加标签（可选，回车或逗号分隔）\" \r\n                                \r\n                                data-on-keydown=\"handleTagInput\" \r\n                                data-keydown-params='[\"event\"]'\r\n\r\n                                data-on-input=\"showSuggestionTags()\">\r\n                            </input>\r\n                        </div>\r\n\r\n                        <div class=\"tag-suggestions\" id=\"tag-suggestions\"></div>\r\n\r\n                    </div>\r\n\r\n                \r\n                    <div class=\"bgc file-upload-container\" id=\"drop-area\">\r\n                        <label for=\"file-input\" class=\"file-input-label\">\r\n                            <i class=\"bi bi-cloud-upload\"></i>\r\n                            <span>添加附件</span>\r\n                            <div class=\"drag-text\">或将文件拖拽到此处</div>\r\n                        </label>\r\n                        <input \r\n                            type=\"file\" \r\n                            name=\"file\" \r\n                            multiple \r\n                            accept=\"image/*,audio/*,video/*\" \r\n                            id=\"file-input\" \r\n                            data-on-change=\"handleFileSelect(event)\">\r\n                        <div id=\"drop-area-overlay\" style=\"display: none; position: absolute; inset: 0; background-color: rgba(106, 13, 173, 0.1); border: 2px dashed #6A0DAD; border-radius: 12px; pointer-events: none;\"></div>\r\n                    </div>\r\n\r\n                    <div class=\"form-actions\">\r\n                        <ul id=\"file-list\" class=\"file-list\"></ul>\r\n                    </div>\r\n                </form>\r\n                <!--\r\n                <ul class=\"flashes mt-3\" id=\"flashes\">\r\n                    {% for message in get_flashed_messages() %}\r\n                    <li>{{ message }}</li>\r\n                    {% endfor %}\r\n                </ul>\r\n                -->\r\n\r\n            </div>\r\n            <div class=\"modal-footer\">\r\n                <button type=\"button\" class=\"btn btn-secondary\" data-bs-dismiss=\"modal\" aria-label=\"Close\">取消</button>\r\n                <button type=\"button\" id=\"submit-button\" class=\"btn btn-primary\" data-on-click=\"handleFormSubmit()\">发布</button>\r\n            </div>\r\n            <div class=\"progress-bar-container\" style=\"display:none; padding: 0 1rem 1rem;\">\r\n                <div class=\"progress-bar\" id=\"uploadProgressBar\" style=\"width: 0%;\"></div>\r\n                <div id=\"status-text\" style=\"text-align: center; margin-top: 5px;\"></div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>",
    "config": {
      "title": "wall",
      "menu": {
        "wallActive": "active"
      },
      "scripts": [
        "wall.js",
        "file.js"
      ],
      "styles": [
